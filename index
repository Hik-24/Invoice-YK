      <div class="tnc">
        <h4>Terms &amp; Condition</h4>
        <ol id="p-tnc"></ol>
      </div>

      <div class="foot-logo" id="p-logo2"></div>
      <div class="sign">
        <div id="p-city"></div>
        <div id="p-sig"></div>
        <div class="line"><b id="p-signer"></b><span id="p-signerCo"></span></div>
      </div>
    </div>
  </div>
</div>

<div id="ov">
  <div class="ovbar">
    <button class="primary" onclick="sharePdf()">Bagikan / Simpan PDF</button>
    <button class="ghost" onclick="dlPdf()">Unduh PDF</button>
    <button class="ghost" onclick="dlPng()">Unduh Gambar</button>
    <button class="ghost" onclick="closeExport()">Tutup</button>
  </div>
  <div class="ovhint">Kalau tombol tidak merespons: tekan lama pada gambar invoice di bawah, lalu pilih Simpan ke Foto atau Bagikan.</div>
  <img id="ovimg" alt="Invoice">
</div>

<script>
const $ = id => document.getElementById(id);
const MONTHS = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
const DEFAULT_LOGO = 'data:image/png;base64,';
const DEFAULT_SIG = 'data:image/png;base64,';
let logoData = '', sigData = '';

const rp = n => (n === '' || n == null || isNaN(n)) ? '' : 'Rp' + Math.round(n).toLocaleString('id-ID');
const rpOrDash = n => n > 0 ? rp(n) : '-';
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function numStr() {
  const d = $('num').value.replace(/\D/g, '').slice(0, 6);
  return 'INV#' + (d || '0').padStart(3, '0');
}
function fmtDate(v) { if (!v) return ''; const [y,m,d] = v.split('-'); return `${d}/${m}/${y}`; }
function fmtLong(v) { if (!v) return ''; const [y,m,d] = v.split('-'); return `${d} ${MONTHS[+m-1]} ${y}`; }
function safeGet(k){ try { return localStorage.getItem(k) || ''; } catch(e){ return ''; } }
function safeSet(k,v){ try { localStorage.setItem(k,v); } catch(e){} }

function render() {
  $('p-coName').textContent = $('coName').value;
  $('p-coAddr').textContent = $('coAddr').value;
  $('p-to').textContent = $('to').value;
  { const nv = $('num'), dg = nv.value.replace(/\D/g, '').slice(0, 6); if (nv.value !== dg) nv.value = dg; }
  $('p-num').textContent = numStr();
  $('p-date').textContent = fmtDate($('date').value);
  $('p-due').textContent = fmtDate($('due').value);

  let sum = 0, rows = '';
  document.querySelectorAll('.item').forEach(el => {
    const d = el.querySelector('.d').value;
    const q = parseFloat(el.querySelector('.q').value);
    const p = parseFloat(el.querySelector('.p').value);
    const has = d || !isNaN(q) || !isNaN(p);
    const amt = (!isNaN(q) && !isNaN(p)) ? q * p : NaN;
    if (!isNaN(amt)) sum += amt;
    rows += `<tr><td>${esc(d)}</td><td class="c">${isNaN(q) ? '' : q}</td><td class="r">${has && !isNaN(p) ? rp(p) : ''}</td><td class="r">${isNaN(amt) ? '' : rp(amt)}</td></tr>`;
  });
  $('p-rows').innerHTML = rows;

  const disc = parseFloat($('disc').value) || 0;
  const dp = parseFloat($('dp').value) || 0;
  const total = Math.max(sum - disc, 0);
  const due = Math.max(total - dp, 0);
  $('p-disc').textContent = rpOrDash(disc);
  $('p-total').textContent = rp(total);
  $('p-dp').textContent = rp(dp);
  $('p-due-amt').textContent = rp(due);

  $('p-bank').textContent = $('bank').value;
  $('p-tnc').innerHTML = $('tnc').value.split('\n').map(s => s.trim()).filter(Boolean).map(s => `<li>${esc(s)}</li>`).join('');

  const dateLong = fmtLong($('date').value);
  $('p-city').textContent = $('city').value + (dateLong ? ', ' + dateLong : '');
  $('p-signer').textContent = $('signer').value;
  $('p-signerCo').textContent = $('coName').value;

  const logoHtml = logoData ? `<img src="${logoData}" alt="logo">` : `<div class="logo-fallback">SnapTime</div>`;
  $('p-logo').innerHTML = logoHtml;
  $('p-logo2').innerHTML = logoHtml;
  $('p-sig').innerHTML = sigData ? `<img src="${sigData}" alt="ttd">` : '<div style="height:20mm"></div>';
}

function readImage(input, cb) {
  const f = input.files[0]; if (!f) return;
  const r = new FileReader(); r.onload = () => cb(r.result); r.readAsDataURL(f);
}
$('logo').addEventListener('change', e => readImage(e.target, d => { logoData = d; safeSet('invyk_logo', d); render(); }));
$('sig').addEventListener('change', e => readImage(e.target, d => { sigData = d; safeSet('invyk_sig', d); render(); }));

// persist fixed settings
['coName','coAddr','bank','tnc','city','signer'].forEach(id => {
  const saved = safeGet('invyk_' + id); if (saved) $(id).value = saved;
  $(id).addEventListener('input', () => safeSet('invyk_' + id, $(id).value));
});
logoData = safeGet('invyk_logo') || DEFAULT_LOGO; sigData = safeGet('invyk_sig') || DEFAULT_SIG;

// defaults for dates
(function(){
  const t = new Date(); const iso = d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  $('date').value = iso(t);
  const n = new Date(t); n.setDate(n.getDate() + 1); $('due').value = iso(n);
})();

function resetForm() {
  ['to','num'].forEach(id => $(id).value = '');
  document.querySelectorAll('.item input').forEach(i => i.value = '');
  document.querySelector('.item .d').value = 'Reservation Package';
  document.querySelector('.item .q').value = 1;
  $('disc').value = 0; $('dp').value = 0;
  render();
}

/* ===== EXPORT (gambar + PDF tanpa window.print) ===== */
let exp = { png:'', pdf:null, name:'invoice' };

function drawInvoice() {
  const sh = $('sheet'), prev = sh.style.transform;
  sh.style.transform = 'none';
  const base = sh.getBoundingClientRect();
  const W = sh.offsetWidth, H = Math.max(sh.offsetHeight, Math.round(297 * 96 / 25.4));
  const K = 2, cv = document.createElement('canvas');
  cv.width = Math.round(W * K); cv.height = Math.round(H * K);
  const c = cv.getContext('2d'); c.scale(K, K);
  c.fillStyle = '#fff'; c.fillRect(0, 0, W, H);
  const INK = '#1c1b1b';
  const rel = el => { const r = el.getBoundingClientRect(); return { l:r.left-base.left, t:r.top-base.top, r:r.right-base.left, b:r.bottom-base.top, w:r.width, h:r.height }; };

  function wrap(str, maxW) {
    const out = [];
    String(str).split('\n').forEach(par => {
      let line = '';
      par.split(' ').forEach(w => {
        const t = line ? line + ' ' + w : w;
        if (line && c.measureText(t).width > maxW) { out.push(line); line = w; } else line = t;
      });
      out.push(line);
    });
    return out;
  }
  function txt(el, str, o) {
    o = o || {};
    str = (str == null ? el.textContent : str);
    if (!str) return;
    const boxEl = o.box || el, cs = getComputedStyle(boxEl), ce = getComputedStyle(el), r = rel(boxEl);
    const fs = parseFloat(ce.fontSize);
    c.font = ce.fontStyle + ' ' + ce.fontWeight + ' ' + ce.fontSize + ' ' + ce.fontFamily;
    c.fillStyle = ce.color; c.textBaseline = 'middle';
    if ('letterSpacing' in c) c.letterSpacing = (ce.letterSpacing === 'normal') ? '0px' : ce.letterSpacing;
    const pl = parseFloat(cs.paddingLeft) + parseFloat(cs.borderLeftWidth) || 0;
    const pr = parseFloat(cs.paddingRight) + parseFloat(cs.borderRightWidth) || 0;
    const pt = parseFloat(cs.paddingTop) + parseFloat(cs.borderTopWidth) || 0;
    const pb = parseFloat(cs.paddingBottom) + parseFloat(cs.borderBottomWidth) || 0;
    const x0 = r.l + pl, x1 = r.r - pr;
    const lhRaw = parseFloat(ce.lineHeight), lh = isNaN(lhRaw) ? fs * 1.15 : lhRaw;
    const lines = wrap(str, x1 - x0);
    const align = o.align || cs.textAlign;
    const top0 = o.top ? r.t + pt : r.t + pt + ((r.h - pt - pb) - lines.length * lh) / 2;
    lines.forEach((ln, i) => {
      const y = top0 + lh * (i + 0.5);
      let x = x0; c.textAlign = 'left';
      if (align === 'center') { x = (x0 + x1) / 2; c.textAlign = 'center'; }
      else if (align === 'right' || align === 'end') { x = x1; c.textAlign = 'right'; }
      c.fillText(ln, x, y);
    });
    if ('letterSpacing' in c) c.letterSpacing = '0px';
    return { top0: top0, lh: lh };
  }
  function img(el) {
    if (!el || !el.complete) return;
    const r = rel(el); c.drawImage(el, r.l, r.t, r.w, r.h);
  }

  // header
  txt(document.querySelector('.head h1'));
  txt($('p-coName')); txt($('p-coAddr'));
  img(document.querySelector('#p-logo img'));
  { const r = rel(document.querySelector('hr.rule')); c.fillStyle = INK; c.fillRect(r.l, r.t, r.w, 3); }

  // invoice to + meta
  txt(document.querySelector('.to h4'));
  txt($('p-to'));
  document.querySelectorAll('table.meta td').forEach(td => txt(td));

  // main table: backgrounds, borders, text
  const cells = Array.from(document.querySelectorAll('table.items th, table.items td'));
  cells.forEach(td => {
    const bg = getComputedStyle(td).backgroundColor;
    if (bg && bg !== 'rgba(0, 0, 0, 0)' && bg !== 'transparent') { const r = rel(td); c.fillStyle = bg; c.fillRect(r.l, r.t, r.w, r.h); }
  });
  c.strokeStyle = INK; c.lineWidth = 2;
  cells.forEach(td => { const r = rel(td); c.strokeRect(r.l, r.t, r.w, r.h); });
  cells.forEach(td => {
    if (td.classList.contains('pay')) { txt(td.querySelector('h5'), null, { top:true }); txt($('p-bank'), null, { top:true }); }
    else txt(td);
  });

  // terms
  txt(document.querySelector('.tnc h4'));
  document.querySelectorAll('#p-tnc li').forEach((li, i) => {
    const m = txt(li, null, { top:true, align:'left' });
    if (m) {
      const r = rel(li), ce = getComputedStyle(li);
      c.font = ce.fontStyle + ' ' + ce.fontWeight + ' ' + ce.fontSize + ' ' + ce.fontFamily;
      c.fillStyle = ce.color; c.textAlign = 'right'; c.textBaseline = 'middle';
      c.fillText((i + 1) + '.', r.l - 4, m.top0 + m.lh / 2);
    }
  });

  // signature block + footer logo
  txt($('p-city'));
  img(document.querySelector('#p-sig img'));
  { const r = rel(document.querySelector('.sign .line')); c.fillStyle = INK; c.fillRect(r.l, r.t, r.w, 2); }
  txt($('p-signer'));
  { const sg = rel(document.querySelector('.sign')), el = $('p-signerCo'), r = rel(el), ce = getComputedStyle(el);
    c.font = ce.fontStyle + ' ' + ce.fontWeight + ' ' + ce.fontSize + ' ' + ce.fontFamily;
    c.fillStyle = ce.color; c.textAlign = 'center'; c.textBaseline = 'middle';
    c.fillText(el.textContent, (sg.l + sg.r) / 2, r.t + r.h / 2); }
  img(document.querySelector('#p-logo2 img'));

  sh.style.transform = prev;
  return cv;
}

function b64ToBytes(u) {
  const b = atob(u.split(',')[1]), a = new Uint8Array(b.length);
  for (let i = 0; i < b.length; i++) a[i] = b.charCodeAt(i);
  return a;
}
function buildPdf(jpg, pxW, pxH) {
  const enc = s => { const a = new Uint8Array(s.length); for (let i = 0; i < s.length; i++) a[i] = s.charCodeAt(i) & 255; return a; };
  const parts = [], offs = []; let len = 0;
  const push = d => { const u = (typeof d === 'string') ? enc(d) : d; parts.push(u); len += u.length; };
  const obj = (n, body) => { offs[n] = len; push(n + ' 0 obj\n'); body.forEach(push); push('\nendobj\n'); };
  push('%PDF-1.4\n');
  obj(1, ['<< /Type /Catalog /Pages 2 0 R >>']);
  obj(2, ['<< /Type /Pages /Kids [3 0 R] /Count 1 >>']);
  obj(3, ['<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595.28 841.89] /Resources << /XObject << /Im0 4 0 R >> >> /Contents 5 0 R >>']);
  obj(4, ['<< /Type /XObject /Subtype /Image /Width ' + pxW + ' /Height ' + pxH + ' /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ' + jpg.length + ' >>\nstream\n', jpg, '\nendstream']);
  const cs = 'q 595.28 0 0 841.89 0 0 cm /Im0 Do Q';
  obj(5, ['<< /Length ' + cs.length + ' >>\nstream\n' + cs + '\nendstream']);
  const xr = len;
  let x = 'xref\n0 6\n0000000000 65535 f \n';
  for (let i = 1; i <= 5; i++) x += String(offs[i]).padStart(10, '0') + ' 00000 n \n';
  x += 'trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n' + xr + '\n%%EOF';
  push(x);
  const out = new Uint8Array(len); let p = 0;
  parts.forEach(u => { out.set(u, p); p += u.length; });
  return out;
}
function openExport() {
  render();
  const cv = drawInvoice();
  exp.png = cv.toDataURL('image/png');
  const jpg = b64ToBytes(cv.toDataURL('image/jpeg', 0.92));
  exp.pdf = new Blob([buildPdf(jpg, cv.width, cv.height)], { type:'application/pdf' });
  exp.name = numStr().replace('#', '-');
  $('ovimg').src = exp.png;
  $('ov').style.display = 'block';
  $('ov').scrollTop = 0;
  window.__exp = exp;
}
function closeExport() { $('ov').style.display = 'none'; }
function saveBlob(blob, name) {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = name;
  document.body.appendChild(a); a.click();
  setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 4000);
}
function dlPdf() { saveBlob(exp.pdf, exp.name + '.pdf'); }
function dlPng() { fetch(exp.png).then(r => r.blob()).then(b => saveBlob(b, exp.name + '.png')); }
function sharePdf() {
  try {
    const f = new File([exp.pdf], exp.name + '.pdf', { type:'application/pdf' });
    if (navigator.canShare && navigator.canShare({ files:[f] })) { navigator.share({ files:[f], title:exp.name }).catch(() => {}); return; }
  } catch (e) {}
  dlPdf();
}

function fit() {
  const st = document.querySelector('.stage'), sh = $('sheet');
  sh.style.transform = 'none'; st.style.height = 'auto';
  const s = Math.min(1, st.clientWidth / sh.offsetWidth);
  if (s < 1) { sh.style.transform = 'scale(' + s + ')'; st.style.height = (sh.offsetHeight * s) + 'px'; }
}
function refresh() { render(); fit(); }
document.querySelectorAll('.panel input, .panel textarea').forEach(el => el.addEventListener('input', refresh));
window.addEventListener('resize', fit);
window.addEventListener('orientationchange', () => setTimeout(fit, 200));
window.addEventListener('beforeprint', () => { const sh = $('sheet'); sh.style.transform = 'none'; });
window.addEventListener('afterprint', fit);
refresh();
</script>

<div class="app">

  <!-- ===== FORM ===== -->
  <div class="panel">
    <h2>Invoice Snaptime Yogyakarta</h2>

    <label>Invoice To</label>
    <input id="to" placeholder="Nama klien">
    <div class="row">
      <div><label>Invoice Number</label>
        <div class="prefix-wrap"><span class="prefix">INV#</span><input id="num" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="000" autocomplete="off"></div>
        <div class="hint">Cukup ketik angkanya, contoh 74 menjadi INV#074.</div></div>
    </div>
    <div class="row">
      <div><label>Invoice Date</label><input id="date" type="date"></div>
      <div><label>Due Date</label><input id="due" type="date"></div>
    </div>

    <h3>Item</h3>
    <div id="items">
      <div class="item">
        <input class="d" placeholder="Description 1" value="Reservation Package" style="margin-bottom:6px">
        <div class="row">
          <input class="q" type="number" inputmode="numeric" min="0" placeholder="Qty" value="1">
          <input class="p" type="number" inputmode="numeric" min="0" placeholder="Price (Rp)">
        </div>
      </div>
      <div class="item">
        <input class="d" placeholder="Description 2" style="margin-bottom:6px">
        <div class="row">
          <input class="q" type="number" inputmode="numeric" min="0" placeholder="Qty">
          <input class="p" type="number" inputmode="numeric" min="0" placeholder="Price (Rp)">
        </div>
      </div>
      <div class="item">
        <input class="d" placeholder="Description 3" style="margin-bottom:6px">
        <div class="row">
          <input class="q" type="number" inputmode="numeric" min="0" placeholder="Qty">
          <input class="p" type="number" inputmode="numeric" min="0" placeholder="Price (Rp)">
        </div>
      </div>
      <div class="item">
        <input class="d" placeholder="Description 4" style="margin-bottom:6px">
        <div class="row">
          <input class="q" type="number" inputmode="numeric" min="0" placeholder="Qty">
          <input class="p" type="number" inputmode="numeric" min="0" placeholder="Price (Rp)">
        </div>
      </div>
      <div class="item">
        <input class="d" placeholder="Description 5" style="margin-bottom:6px">
        <div class="row">
          <input class="q" type="number" inputmode="numeric" min="0" placeholder="Qty">
          <input class="p" type="number" inputmode="numeric" min="0" placeholder="Price (Rp)">
        </div>
      </div>
    </div>

    <div class="row">
      <div><label>Discount (Rp)</label><input id="disc" type="number" inputmode="numeric" min="0" value="0"></div>
      <div><label>DP / Down Payment (Rp)</label><input id="dp" type="number" inputmode="numeric" min="0" value="0"></div>
    </div>
    <div class="hint">Total dan Amount Date dihitung otomatis: Total = jumlah item − diskon, Amount Date = Total − DP.</div>

    <div class="btns">

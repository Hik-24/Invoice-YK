<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Invoice Snaptime Yogyakarta</title>
<style>
  :root { --navy:#1f2a7c; --lilac:#a9b0dd; --ink:#1c1b1b; }
  * { box-sizing: border-box; }
  body { margin:0; font-family: Arial, Helvetica, sans-serif; background:#e9eaf0; color:var(--ink); }
  .app { display:flex; gap:20px; padding:20px; align-items:flex-start; flex-wrap:wrap; }

  /* ===== FORM ===== */
  .panel { width:360px; max-width:100%; background:#fff; border-radius:12px; padding:18px; box-shadow:0 2px 10px rgba(0,0,0,.08); }
  .panel h2 { margin:0 0 12px; font-size:18px; color:var(--navy); }
  .panel h3 { margin:16px 0 8px; font-size:13px; text-transform:uppercase; letter-spacing:.05em; color:#666; }
  label { display:block; font-size:12px; color:#555; margin:8px 0 3px; }
  input, textarea { width:100%; padding:8px 9px; border:1px solid #c9ccd8; border-radius:6px; font:inherit; font-size:16px; -webkit-appearance:none; appearance:none; background:#fff; color:var(--ink); }
  input[type=date] { min-height:40px; }
  .prefix-wrap { display:flex; align-items:stretch; }
  .prefix { display:flex; align-items:center; padding:0 12px; background:#eceefa; border:1px solid #c9ccd8; border-right:0; border-radius:6px 0 0 6px; font-size:16px; font-weight:bold; color:var(--navy); }
  .prefix-wrap input { border-radius:0 6px 6px 0; }
  input[type=file] { font-size:14px; padding:6px; }
  textarea { resize:vertical; }
  .row { display:flex; gap:8px; }
  .row > * { flex:1; }
  .item { border:1px solid #e1e3ec; border-radius:8px; padding:8px; margin-bottom:8px; background:#fafbff; }
  .item .row input { margin:0; }
  .item small { color:#888; font-size:11px; }
  .btns { display:flex; gap:8px; margin-top:16px; }
  button { flex:1; padding:10px; border:0; border-radius:8px; font-size:14px; font-weight:bold; cursor:pointer; }
  .primary { background:var(--navy); color:#fff; }
  .ghost { background:#eceefa; color:var(--navy); }
  details { margin-top:14px; border-top:1px solid #eee; padding-top:8px; }
  summary { cursor:pointer; font-size:13px; color:var(--navy); font-weight:bold; }
  .hint { font-size:11px; color:#888; margin-top:4px; }

  /* ===== INVOICE (A4) ===== */
  .stage { flex:1; min-width:0; overflow:hidden; }
  #sheet { transform-origin:top left; }
  #sheet { width:210mm; min-height:297mm; background:#fff; padding:14mm 16mm; position:relative; margin:0 auto; box-shadow:0 2px 14px rgba(0,0,0,.15); font-size:11pt; }
  .head { display:flex; justify-content:space-between; align-items:flex-start; }
  .head h1 { font-size:44pt; margin:0 0 6px; line-height:1; letter-spacing:-1px; }
  .co-name { font-weight:bold; font-size:14pt; margin-bottom:4px; }
  .co-addr { font-size:11pt; line-height:1.35; max-width:95mm; white-space:pre-line; }
  .logo-box img { max-height:22mm; max-width:60mm; }
  .logo-fallback { font-size:30pt; font-weight:900; color:#1b2fb0; font-style:italic; letter-spacing:-1px; }
  hr.rule { border:0; border-top:3px solid var(--ink); margin:10px 0 12px; }
  .to h4 { margin:0 0 6px; font-size:15pt; }
  .meta { border-collapse:collapse; font-size:10.5pt; }
  .meta td { padding:2px 0; }
  .meta td:first-child { font-weight:bold; width:36mm; }
  table.items { width:100%; border-collapse:collapse; margin-top:12px; }
  table.items th { background:var(--navy); color:#fff; padding:8px; font-size:10pt; text-align:left; border:2px solid var(--ink); }
  table.items td { border:2px solid var(--ink); padding:8px; height:11mm; font-size:10pt; }
  .r { text-align:right; } .c { text-align:center; }
  table.items { table-layout:fixed; }
  table.items td.pay { vertical-align:top; padding:10px 12px; height:auto; }
  table.items .pay h5 { font-size:13pt; margin:4px 0 8px; }
  table.items .pay div { font-size:9.5pt; line-height:1.4; white-space:pre-line; }
  table.items tfoot td { height:11mm; }
  table.items tfoot tr.due td { background:var(--lilac); }
  .tnc h4 { font-size:15pt; margin:10px 0 4px; }
  .tnc ol { margin:0; padding-left:18px; font-size:9.5pt; line-height:1.35; }
  .sign { position:absolute; right:16mm; bottom:14mm; width:62mm; text-align:center; font-size:10pt; }
  .sign img { max-height:20mm; max-width:50mm; display:block; margin:6px auto; }
  .sign .line { border-top:2px solid var(--ink); padding-top:4px; margin-top:4px; }
  .sign b { display:block; font-size:11pt; }
  .foot-logo { position:absolute; left:16mm; bottom:12mm; }
  .foot-logo img { max-height:15mm; }
  .foot-logo .logo-fallback { font-size:22pt; }

  #ov { display:none; position:fixed; left:0; top:0; right:0; bottom:0; background:rgba(20,22,40,.96); z-index:99; overflow:auto; -webkit-overflow-scrolling:touch; padding:12px; }
  .ovbar { display:flex; gap:8px; flex-wrap:wrap; max-width:820px; margin:0 auto 8px; }
  .ovbar button { flex:1 1 40%; }
  .ovhint { max-width:820px; margin:0 auto 10px; color:#cfd3ee; font-size:13px; }
  #ovimg { display:block; width:100%; max-width:820px; margin:0 auto; background:#fff; }
  @media (max-width: 820px) {
    .app { display:block; padding:10px; }
    .panel { width:100%; margin-bottom:14px; }
  }
  @media print {
    @page { size:A4; margin:0; }
    body { background:#fff; }
    .panel, #ov { display:none !important; }
    .app { padding:0; display:block; }
    .stage { overflow:visible; }
    .stage { height:auto !important; }
    #sheet { box-shadow:none; margin:0; transform:none !important; height:296mm; min-height:0; overflow:hidden; }
    * { -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  }
</style>
</head>
